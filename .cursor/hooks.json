{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/hooks/session_start.sh",
        "timeout": 12
      }
    ],
    "preCompact": [
      {
        "command": ".cursor/hooks/session_stamp.sh",
        "timeout": 15
      }
    ],
    "sessionEnd": [
      {
        "command": ".cursor/hooks/session_stamp.sh",
        "timeout": 15
      }
    ]
  }
}
